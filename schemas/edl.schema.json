{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "edl.schema.json",
  "title": "Edit Decision List",
  "type": "object",
  "required": [
    "slug",
    "version",
    "fps",
    "width",
    "height",
    "theme",
    "segments"
  ],
  "properties": {
    "slug": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "fps": {
      "enum": [
        24,
        25,
        30
      ]
    },
    "width": {
      "type": "integer"
    },
    "height": {
      "type": "integer"
    },
    "theme": {
      "$ref": "#/$defs/theme"
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "scene_id",
          "kind",
          "duration_s"
        ],
        "properties": {
          "scene_id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "clip",
              "broll"
            ]
          },
          "duration_s": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "src": {
            "type": "string",
            "description": "Path relative to remotion/public"
          },
          "in_s": {
            "type": "number",
            "minimum": 0
          },
          "playback_rate": {
            "type": "number",
            "minimum": 0.8,
            "maximum": 1.2
          },
          "grade": {
            "type": "object",
            "properties": {
              "brightness": {
                "type": "number"
              },
              "contrast": {
                "type": "number"
              },
              "saturate": {
                "type": "number"
              }
            }
          },
          "broll": {
            "$ref": "#/$defs/templateRef"
          },
          "transition_in": {
            "$ref": "#/$defs/transition"
          },
          "transition_frames": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30
          },
          "overlays": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/overlay"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "clip"
                }
              }
            },
            "then": {
              "required": [
                "src"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "broll"
                }
              }
            },
            "then": {
              "required": [
                "broll"
              ]
            }
          }
        ]
      }
    },
    "audio": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "role",
          "src"
        ],
        "properties": {
          "role": {
            "enum": [
              "vo",
              "music",
              "sfx"
            ]
          },
          "src": {
            "type": "string"
          },
          "start_s": {
            "type": "number",
            "minimum": 0
          },
          "volume": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "duck_under_vo": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    }
  },
  "$defs": {
    "transition": {
      "enum": [
        "cut",
        "fade",
        "slide",
        "wipe",
        "match-cut"
      ]
    },
    "templateRef": {
      "type": "object",
      "required": [
        "template",
        "props"
      ],
      "properties": {
        "template": {
          "enum": [
            "TitleCard",
            "KineticText",
            "StatCounter",
            "BulletList",
            "QuoteCard",
            "SplitCompare",
            "BarChart",
            "CTA",
            "ChatInbox",
            "CountUp",
            "SpendBars",
            "OvernightReport",
            "ReplyThread",
            "CapabilityTicks",
            "EndCard",
            "ChatList",
            "ChatThread",
            "AdsRow",
            "CalendarSlot",
            "WAInbox",
            "WAThread",
            "WACalendar",
            "MetaAds"
          ]
        },
        "props": {
          "type": "object"
        }
      }
    },
    "overlay": {
      "type": "object",
      "required": [
        "template",
        "props",
        "from_s",
        "to_s"
      ],
      "properties": {
        "template": {
          "enum": [
            "LowerThird",
            "Caption",
            "CalloutTag",
            "VCaption",
            "VTag"
          ]
        },
        "props": {
          "type": "object"
        },
        "from_s": {
          "type": "number",
          "minimum": 0
        },
        "to_s": {
          "type": "number"
        }
      }
    },
    "theme": {
      "type": "object",
      "required": [
        "colors",
        "fonts"
      ],
      "properties": {
        "colors": {
          "type": "object",
          "required": [
            "background",
            "primary",
            "accent",
            "text"
          ],
          "properties": {
            "background": {
              "$ref": "#/$defs/hex"
            },
            "primary": {
              "$ref": "#/$defs/hex"
            },
            "accent": {
              "$ref": "#/$defs/hex"
            },
            "text": {
              "$ref": "#/$defs/hex"
            },
            "muted": {
              "$ref": "#/$defs/hex"
            }
          }
        },
        "fonts": {
          "type": "object",
          "required": [
            "heading",
            "body"
          ],
          "properties": {
            "heading": {
              "type": "string"
            },
            "body": {
              "type": "string"
            }
          }
        },
        "motion": {
          "type": "object",
          "properties": {
            "damping": {
              "type": "number"
            },
            "stiffness": {
              "type": "number"
            },
            "entrance_frames": {
              "type": "integer"
            },
            "exit_frames": {
              "type": "integer"
            },
            "stagger_frames": {
              "type": "integer",
              "description": "Frames between staggered element entrances (2-5 at 24 fps)"
            },
            "overshoot_clamp": {
              "type": "boolean",
              "description": "true = premium look, no bounce"
            },
            "preset": {
              "enum": [
                "snappy",
                "pop",
                "bouncy",
                "elegant",
                "premium"
              ]
            }
          }
        },
        "unify": {
          "type": "object",
          "description": "Unification pass: one grain layer over footage AND graphics, sub-pixel soften on clips",
          "properties": {
            "grain_opacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.3
            },
            "clip_blur_px": {
              "type": "number",
              "minimum": 0,
              "maximum": 1.5
            }
          }
        }
      }
    },
    "hex": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    }
  }
}
