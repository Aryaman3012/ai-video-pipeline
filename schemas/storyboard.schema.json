{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "storyboard.schema.json",
  "title": "Storyboard (storyboard flow)",
  "type": "object",
  "required": ["slug", "brand", "clips"],
  "properties": {
    "slug": { "type": "string" },
    "fps": { "enum": [24, 25, 30] },
    "generator": { "type": "string" },
    "brand": {
      "type": "object", "required": ["name"],
      "properties": { "name": { "type": "string" }, "logo_light": { "type": "string" }, "logo_dark": { "type": "string" } }
    },
    "framing": {
      "type": "object",
      "properties": { "face_x": { "type": "number", "minimum": 0, "maximum": 1 }, "face_y": { "type": "number", "minimum": 0, "maximum": 1 }, "body_y": { "type": "number", "minimum": 0, "maximum": 1 } }
    },
    "palette": { "type": "object", "additionalProperties": { "type": "string" } },
    "captions": {
      "type": "object",
      "properties": {
        "landscape": { "type": "boolean" }, "vertical": { "type": "boolean" },
        "emphasis": { "type": "object", "properties": { "pos": { "type": "array", "items": { "type": "string" } }, "neg": { "type": "array", "items": { "type": "string" } } } }
      }
    },
    "end_card": {
      "type": "object", "required": ["seconds", "headline", "cta"],
      "properties": { "seconds": { "type": "number", "minimum": 0 }, "headline": { "type": "string" }, "cta": { "type": "string" }, "url": { "type": "string" }, "background": { "$ref": "#/$defs/scene" } }
    },
    "music_volume": { "type": "number" },
    "clips": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/clip" } }
  },
  "$defs": {
    "cue": { "oneOf": [{ "type": "number", "minimum": 0 }, { "type": "string", "minLength": 1 }] },
    "mode": { "enum": ["full", "split", "pip"] },
    "scene": {
      "type": "object", "required": ["name", "layer"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
        "layer": { "enum": ["under", "beside", "over"] },
        "idea": { "type": "string" },
        "props": { "type": "object" },
        "cues": { "type": "object", "additionalProperties": { "$ref": "#/$defs/cue" } }
      }
    },
    "clip": {
      "type": "object", "required": ["id", "view", "line", "edit"],
      "properties": {
        "id": { "type": "string", "pattern": "^[0-9]{2}$" },
        "section": { "type": "string" },
        "view": { "type": "string" },
        "line": { "type": "string", "minLength": 1 },
        "prompt": { "type": "object" },
        "edit": {
          "type": "object",
          "properties": {
            "host": { "type": "array", "minItems": 1, "items": { "type": "array", "prefixItems": [{ "$ref": "#/$defs/cue" }, { "$ref": "#/$defs/mode" }], "minItems": 2, "maxItems": 2 } },
            "from": { "$ref": "#/$defs/mode" },
            "push": { "type": "number", "minimum": 0, "maximum": 0.4 },
            "grade": { "enum": ["cool", "warm", "neutral"] },
            "captions": { "type": "boolean" },
            "scenes": { "type": "array", "items": { "$ref": "#/$defs/scene" } }
          }
        }
      }
    }
  }
}
