{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scene-prompt.schema.json",
  "title": "Scene Prompt",
  "type": "object",
  "required": [
    "scene_id",
    "intent",
    "acceptance_criteria",
    "takes"
  ],
  "properties": {
    "scene_id": {
      "type": "string",
      "pattern": "^(scene-\\d{3}[a-z]?|clip-\\d{2}|broll-b\\d{2})$"
    },
    "intent": {
      "type": "string"
    },
    "generator": {
      "enum": [
        "runway",
        "veo",
        "other"
      ],
      "description": "Generator the prompt was rendered for (state.json → format.generator.name). Absent = runway."
    },
    "view": {
      "type": "string",
      "pattern": "^(podcast-host|podcast-guest|presenter-to-camera|broll-silent\\.(screen|location|aerial|person|interaction))$",
      "description": "Template in templates/prompts/ the takes were rendered from"
    },
    "continuity_inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 3,
      "maxItems": 5
    },
    "takes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "take",
          "model",
          "mode",
          "prompt",
          "duration_s",
          "aspect_ratio",
          "output_path"
        ],
        "properties": {
          "take": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "model": {
            "type": "string",
            "examples": [
              "gen4.5",
              "gen4_turbo",
              "Veo 3.1 Fast"
            ]
          },
          "mode": {
            "enum": [
              "text_to_video",
              "image_to_video"
            ]
          },
          "prompt": {
            "type": "string",
            "minLength": 20,
            "maxLength": 5000,
            "description": "Rendered prompt text. Negative phrasing is only rejected for generators whose profile sets negative_phrasing: false (runway)."
          },
          "keyframe": {
            "type": [
              "string",
              "null"
            ]
          },
          "duration_s": {
            "type": "number",
            "minimum": 1,
            "maximum": 60,
            "description": "Bounded per generator profile by the validator (runway 2–10, veo 8)"
          },
          "aspect_ratio": {
            "enum": [
              "16:9",
              "9:16",
              "1:1",
              "4:3",
              "3:4",
              "21:9"
            ]
          },
          "fps": {
            "enum": [
              24,
              25,
              30
            ]
          },
          "seed": {
            "type": [
              "integer",
              "null"
            ]
          },
          "prompt_delta_applied": {
            "type": [
              "string",
              "null"
            ]
          },
          "credits_estimate": {
            "type": "number"
          },
          "output_path": {
            "type": "string",
            "pattern": "^04_clips/(scene-\\d{3}[a-z]?|clip-\\d{2}|broll-b\\d{2})_take-0[1-3]\\.mp4$"
          },
          "generated_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "slots": {
            "type": "object",
            "description": "Template slot values this take was rendered from (tools/render-prompt.mjs)"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "mode": {
                  "const": "image_to_video"
                }
              }
            },
            "then": {
              "required": [
                "keyframe"
              ],
              "properties": {
                "keyframe": {
                  "type": "string"
                }
              }
            }
          }
        ]
      }
    },
    "keyframe_prompt": {
      "type": "object",
      "description": "Image prompt for a first-frame still to generate before the clip (view keyframe-still)",
      "required": [
        "output_path"
      ],
      "properties": {
        "view": {
          "const": "keyframe-still"
        },
        "slots": {
          "type": "object"
        },
        "prompt": {
          "type": "string"
        },
        "output_path": {
          "type": "string",
          "pattern": "^(03_prompts/keyframes|01_vision/refs)/.+\\.(png|jpg|jpeg|webp)$"
        }
      }
    }
  },
  "description": "One A-roll scene's prompt and takes. Generator rules (duration, aspect, negative phrasing, prompt length) live in templates/prompts/generators.json and are enforced by tools/validate.mjs for the project's generator."
}
